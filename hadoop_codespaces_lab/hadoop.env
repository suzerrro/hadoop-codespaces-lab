# Apache Hadoop Docker runner가 환경변수를 Hadoop XML 설정으로 변환합니다.
# 파일 이름과 XML 속성의 대소문자를 그대로 유지하세요.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# ENSURE_NAMENODE_DIR와 동일한 경로: 재시작 시 잘못된 재포맷 방지
HDFS-SITE.XML_dfs.namenode.name.dir=file:///tmp/hadoop-root/dfs/name
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.blocksize=1048576

# YARN / MapReduce: 심화 실습 단계에서만 해당 컨테이너 실행
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=/opr/hadoop
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=/opr/hadoop
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=/opr/hadoop
MAPRED-SITE.XML_mapreduce.map.memory.mb=384
MAPRED-SITE.XML_mapreduce.reduce.memory.mb=384
MAPRED-SITE.XML_mapreduce.map.java.opts=-Xmx256m
MAPRED-SITE.XML_mapreduce.reduce.java.opts=-Xmx256m
MAPRED-SITE.XML_yarn.app.mapreduce.am.resource.mb=384
MAPRED-SITE.XML_yarn.app.mapreduce.am.command-opts=-Xmx256m
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=1536
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=1536
YARN-SITE.XML_yarn.scheduler.minimum-allocation-mb=128
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
